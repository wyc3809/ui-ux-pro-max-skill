{
  "expo": {
    "name": "AppSeed",
    "slug": "appseed",
    "description": "AppSeed, the vibe coding incubator: runnable app source, build stories, prompts, launches and whole app buyouts.",
    "scheme": "appseed",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#f5f6f3",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.appseed.mobile",
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:appseed.app"
      ]
    },
    "android": {
      "package": "app.appseed.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#5b3fd6",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "appseed.app",
              "pathPrefix": "/t"
            },
            {
              "scheme": "https",
              "host": "appseed.app",
              "pathPrefix": "/p"
            },
            {
              "scheme": "https",
              "host": "appseed.app",
              "pathPrefix": "/l"
            },
            {
              "scheme": "https",
              "host": "appseed.app",
              "pathPrefix": "/b"
            },
            {
              "scheme": "https",
              "host": "appseed.app",
              "pathPrefix": "/template"
            },
            {
              "scheme": "https",
              "host": "appseed.app",
              "pathPrefix": "/prompt"
            },
            {
              "scheme": "https",
              "host": "appseed.app",
              "pathPrefix": "/launch"
            },
            {
              "scheme": "https",
              "host": "appseed.app",
              "pathPrefix": "/post"
            },
            {
              "scheme": "https",
              "host": "appseed.app",
              "pathPrefix": "/creator"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      "expo-font",
      "expo-localization",
      "expo-system-ui",
      "expo-asset",
      "expo-apple-authentication",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
