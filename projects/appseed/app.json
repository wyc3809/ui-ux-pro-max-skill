{
  "expo": {
    "name": "VCseed",
    "slug": "vcseed",
    "description": "VCseed, the vibe coding incubator: runnable app source, build stories, prompts, launches and whole app buyouts.",
    "scheme": "vcseed",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#f5f5f7",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.vcseed.mobile",
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:vcseed.app"
      ],
      "icon": {
        "light": "./assets/icon.png",
        "dark": "./assets/icon-dark.png",
        "tinted": "./assets/icon-tinted.png"
      }
    },
    "android": {
      "package": "app.vcseed.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#08080A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "vcseed.app",
              "pathPrefix": "/t"
            },
            {
              "scheme": "https",
              "host": "vcseed.app",
              "pathPrefix": "/p"
            },
            {
              "scheme": "https",
              "host": "vcseed.app",
              "pathPrefix": "/l"
            },
            {
              "scheme": "https",
              "host": "vcseed.app",
              "pathPrefix": "/b"
            },
            {
              "scheme": "https",
              "host": "vcseed.app",
              "pathPrefix": "/template"
            },
            {
              "scheme": "https",
              "host": "vcseed.app",
              "pathPrefix": "/prompt"
            },
            {
              "scheme": "https",
              "host": "vcseed.app",
              "pathPrefix": "/launch"
            },
            {
              "scheme": "https",
              "host": "vcseed.app",
              "pathPrefix": "/post"
            },
            {
              "scheme": "https",
              "host": "vcseed.app",
              "pathPrefix": "/creator"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      "expo-font",
      "expo-localization",
      "expo-system-ui",
      "expo-asset",
      "expo-apple-authentication",
      "expo-web-browser",
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "VCseed uses your photos to add an app icon, screenshots and a preview video to your listing.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "backgroundColor": "#f5f5f7",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
